# SkillMutator artifact — environment variables
# ------------------------------------------------------------------
# Copy this file to `.env` (same folder as run.sh) and fill in what you need,
# then run e.g.  ./run.sh --tier 2 --env-file .env
# `.env` beside run.sh is also auto-loaded, so --env-file is optional.
#
# Tier 1 (data verification) needs NOTHING here — it is CPU-only, no keys.
# Keys below are only for the live tiers (2–4). Leave any you don't use blank.
# Lines still holding the placeholder value are ignored (not exported).
# ------------------------------------------------------------------

# REQUIRED for Tiers 2–4 — adversarial oracle, LLM scanner, and judge/teacher.
OPENAI_API_KEY=your_openai_api_key_here

# OPTIONAL — enables the Snyk Agent scanner (else its column is left unavailable).
#   Format: snyk_uat.<8-hex>.<base64...>  (see `snyk config get api`)
SNYK_TOKEN=your_snyk_token_here

# OPTIONAL — HuggingFace access for base-model / LoRA-adapter downloads
# (finetune side, Tiers 2–4 with a GPU).
HF_TOKEN=your_huggingface_token_here

# OPTIONAL — Claude-based mutation / the Claude-Opus judge.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPTIONAL — default LLM-scanner provider/model (else set per run via --model).
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# OPTIONAL — Weights & Biases run tracking (Tier 4 training only).
# WANDB_API_KEY=your_wandb_key_here
# WANDB_PROJECT=your_wandb_project
